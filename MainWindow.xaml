<Window x:Class="VibeCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeCopy — 多卡一键归档"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E8ECF2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#ECF0F6"/>
            <Setter Property="BorderBrush" Value="#AAB4C3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78808C"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E222A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="80"/>
            <RowDefinition Height="3*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- 配置 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="归档设置" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Thickness x:Key="Cell">0,2</Thickness>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" Text="目标目录" Margin="{StaticResource Cell}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbTarget" Margin="0,2,6,2"/>
                    <Button    Grid.Row="0" Grid.Column="2" Content="浏览…" Width="72" Margin="{StaticResource Cell}" Click="BtnBrowse_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" Text="扩展名" Margin="{StaticResource Cell}"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TbExts" Margin="{StaticResource Cell}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}" Text="扫描子目录" Margin="{StaticResource Cell}"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TbDirs" Margin="{StaticResource Cell}"
                               ToolTip="留空=全盘扫描"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Muted}" Text="子文件夹规则" Margin="{StaticResource Cell}"/>
                    <Grid      Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource Cell}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox  Grid.Column="0" x:Name="CbTime"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="同名冲突"/>
                        <ComboBox  Grid.Column="4" x:Name="CbConflict"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="CbVerify" Content="复制后校验 (SHA1)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <CheckBox x:Name="CbAutoEject" Content="完成后自动弹出" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 传输 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource Primary}" Content="▶ 开始复制" x:Name="BtnStart" Click="BtnStart_Click"/>
                <Button Grid.Row="0" Grid.Column="2" Content="■ 取消" x:Name="BtnCancel" IsEnabled="False" Click="BtnCancel_Click"/>
                <Grid Grid.Row="0" Grid.Column="4" Height="22">
                    <ProgressBar x:Name="Pb" Minimum="0" Maximum="1" Value="0"
                                 Background="#E8ECF2" BorderBrush="#E0E4EB" Foreground="#007ACC"/>
                    <TextBlock x:Name="LbProgress" Text="0.0%  就绪"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" x:Name="LbStatus"
                           Text="就绪" Foreground="#78808C" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- 盘 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="可移动盘" Style="{StaticResource CardTitle}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟳ 刷新" Margin="0,0,6,0" Click="BtnRefresh_Click"/>
                        <Button Content="⏏ 弹出勾选盘" Click="BtnEject_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" x:Name="DgDrives"
                          AutoGenerateColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeaderWidth="0"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          Background="White" BorderThickness="0"
                          RowHeight="22" FontSize="12"
                          AlternatingRowBackground="#F9FAFC">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding Checked, UpdateSourceTrigger=PropertyChanged}" Width="32"/>
                        <DataGridTextColumn Header="盘符"    Binding="{Binding Name}"  Width="70"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="卷标"    Binding="{Binding Label}" Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="总容量"  Binding="{Binding Total}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="可用"    Binding="{Binding Free}"  Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="文件系统" Binding="{Binding Fs}"    Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="日志" Style="{StaticResource CardTitle}"/>
                <TextBox Grid.Row="1" x:Name="TbLog" IsReadOnly="True"
                         Height="Auto" MinHeight="0"
                         Background="#181C22" Foreground="#DCE2EB"
                         FontFamily="Consolas" FontSize="12"
                         BorderThickness="0" Padding="6"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" AcceptsReturn="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
