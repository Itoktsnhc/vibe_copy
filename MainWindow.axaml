<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VibeCopy"
        x:Class="VibeCopy.MainWindow"
        x:DataType="vm:MainWindow"
        Title="VibeCopy — 通用迁移整理"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI,Segoe UI" FontSize="12"
        Background="#F5F7FA"
        Icon="/icon.ico">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Background" Value="#E8ECF2"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#ECF0F6"/>
            <Setter Property="BorderBrush" Value="#AAB4C3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#78808C"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style Selector="ProgressBar /template/ Border#PART_Indicator">
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style Selector="ProgressBar /template/ Border#PART_ContainerRoot">
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style Selector="TextBox.log /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#181C22"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#181C22"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#181C22"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E222A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Styles>

    <Grid Margin="10" RowDefinitions="Auto,Auto,2*,3*">

        <!-- 配置 -->
        <Border Grid.Row="0" Classes="card" x:Name="SettingsPanel">
            <StackPanel>
                <TextBlock Text="迁移设置" Classes="title"/>
                <Grid ColumnDefinitions="96,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="目标目录" Margin="0,2"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbTarget" Margin="0,2,6,2"/>
                    <Button    Grid.Row="0" Grid.Column="2" Content="浏览…" Width="72" Margin="0,2" Click="BtnBrowse_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="扩展名" Margin="0,2"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TbExts" Margin="0,2"
                               Watermark="留空 = 所有文件；例如 .jpg,.mp4,.pdf"
                               ToolTip.Tip="逗号分隔扩展名；留空表示迁移所有文件"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="muted" Text="扫描子目录" Margin="0,2"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TbDirs" Margin="0,2"
                               Watermark="留空 = 全部内容；例如 DCIM,PRIVATE"
                               ToolTip.Tip="来源目录下的相对扫描子目录，逗号分隔；留空表示扫描全部内容"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="muted" Text="日期依据" Margin="0,2"/>
                    <Grid      Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2"
                               ColumnDefinitions="*,10,Auto,6,*">
                        <ComboBox  Grid.Column="0" x:Name="CbTime" HorizontalAlignment="Stretch"
                                   ToolTip.Tip="creation = 文件创建时间；modified = 最后修改时间"/>
                        <TextBlock Grid.Column="2" Classes="muted" Text="同名冲突"/>
                        <ComboBox  Grid.Column="4" x:Name="CbConflict" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="CbVerify" Content="复制后校验 (SHA1)" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <CheckBox x:Name="CbAutoEject" Content="完成后弹出勾选的移动盘" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Classes="muted" Text="并发" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="NudConcurrency" Width="70" Height="24" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="muted" Text="目标子目录" Margin="0,2"/>
                    <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,8,Auto,6,160">
                        <TextBox Grid.Column="0" x:Name="TbFolderPattern" Margin="0,2" Watermark="yyyy/MM/dd"
                                 ToolTip.Tip="日期格式，例如 yyyy、yyyy/MM、yyyy/MM/dd；使用 / 创建多级目录"/>
                        <TextBlock Grid.Column="2" Classes="muted" Text="常用规则"/>
                        <ComboBox Grid.Column="4" x:Name="CbFolderPreset" HorizontalAlignment="Stretch" Margin="0,2"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LbFolderPreview"
                               Classes="muted" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid ColumnDefinitions="96,*,Auto" Margin="0,4,0,0">
                    <TextBlock Grid.Column="0" Classes="muted" Text="来源目录" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <TextBox Grid.Column="1" x:Name="TbSources" MinHeight="54" Height="54"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             Watermark="每行一个目录；可与下方移动磁盘同时使用"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="添加目录" Width="72" VerticalAlignment="Top" Click="BtnBrowseSources_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 传输 -->
        <Border Grid.Row="1" Classes="card">
            <Grid ColumnDefinitions="Auto,8,Auto,12,*,10,120" RowDefinitions="22,4,22,Auto">
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Classes="primary" Content="▶ 开始复制" x:Name="BtnStart" Height="48" VerticalAlignment="Center" Click="BtnStart_Click"/>
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Content="■ 取消" x:Name="BtnCancel" Height="48" VerticalAlignment="Center" IsEnabled="False" Click="BtnCancel_Click"/>

                <Grid Grid.Row="0" Grid.Column="4">
                    <ProgressBar x:Name="PbOverall" Minimum="0" Maximum="1" Value="0"
                                 Background="#E8ECF2" BorderBrush="#E0E4EB" Foreground="#007ACC"/>
                    <TextBlock x:Name="LbOverall" Text="总进度  0 / 0"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="4">
                    <ProgressBar x:Name="PbCurrent" Minimum="0" Maximum="1" Value="0"
                                 Background="#E8ECF2" BorderBrush="#E0E4EB" Foreground="#4CAF50"/>
                    <TextBlock x:Name="LbCurrent" Text="当前  —"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="6"
                        Background="#181C22" CornerRadius="3">
                    <TextBlock x:Name="TbSpeed" Text="0 B/s"
                               FontWeight="Bold" FontSize="14"
                               Foreground="#4CAF50"
                               FontFamily="Cascadia Mono,Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" x:Name="LbStatus"
                           Text="就绪" Foreground="#78808C" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- 盘 -->
        <Border Grid.Row="2" Classes="card" x:Name="DrivesPanel">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="可移动盘" Classes="title" Margin="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟳ 刷新" Margin="0,0,6,0" Click="BtnRefresh_Click"/>
                        <Button Content="⏏ 弹出勾选盘" x:Name="BtnEject" Click="BtnEject_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="36,80,*,100,100,110" Margin="0,0,0,2">
                    <TextBlock Grid.Column="1" Text="盘符"    Classes="muted"/>
                    <TextBlock Grid.Column="2" Text="卷标"    Classes="muted"/>
                    <TextBlock Grid.Column="3" Text="总容量"  Classes="muted"/>
                    <TextBlock Grid.Column="4" Text="可用"    Classes="muted"/>
                    <TextBlock Grid.Column="5" Text="文件系统" Classes="muted"/>
                </Grid>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DgDrives">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveRow">
                                <Grid ColumnDefinitions="36,80,*,100,100,110" Height="24">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"  VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Total}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Free}"  VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Fs}"    VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Classes="card" Margin="0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="日志" Classes="title"/>
                <TextBox Grid.Row="1" x:Name="TbLog" Classes="log" IsReadOnly="True"
                         Height="NaN" MinHeight="0"
                         VerticalContentAlignment="Top"
                         Background="#181C22" Foreground="#DCE2EB"
                         FontFamily="Cascadia Mono,Consolas,Microsoft YaHei UI" FontSize="12"
                         BorderThickness="0" Padding="6"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
