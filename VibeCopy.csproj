<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VibeCopy</RootNamespace>
    <AssemblyName>VibeCopy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NoWarn>IL2026;IL2070;IL2072;IL2075;IL2104</NoWarn>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="icon.ico"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2"/>
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2"/>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.2"/>
  </ItemGroup>
</Project>
